@page
@using Utilities.Convertors;
@model FS.FruitStore.Pages.AllProductsModel
@{
}

<div class="shop-header">
    <hr size="2px" color="gray">
    <form method="post">
        <div class="input-group my-3">
            <!-- سلکت اپشن انتخاب کتگوری -->
            <select class="custom-select" asp-for="SelectedCat" asp-items="Model.Cats">
                <option>همه</option>
            </select>
            <div class="input-group-append">
                <!-- دکمه اضافه کردن -->
                <button asp-page-handler="FilCat" type="submit" class="btn btn-secondary"> فیلتر </button>
            </div>
        </div>

        @if (Model.Product.Any())
        {
            <div class="row">
                @foreach (var item in Model.Product)
                {


                    <div class="col-lg-3 col-md-3 col-12 my-2">
                        <a asp-page="Product-Details" asp-route-Id="@item.ProductId">
                            <div class="card product-box">
                                <div class="mother-imageBox">
                                    <img class="card-img-top" src="~/ProductImages/@item.ProductPic" alt="this is a img" height="250px">
                                </div>
                                <div class="card-body product-box-body">
                                    <h5 class="card-title h5 text-center text-success" style="font-size: 18px; font-weight: 600;">
                                        @item.Name
                                    </h5>
                                    <p class="h6 text-primary text-center" style="font-weight: 600"> @item.Price.ToToman() </p>
                                </div>
                            </div>
                        </a>
                    </div>

                }
            </div>

            @if (Model.PagingInfo.TotalPage > 1)
            {
                <nav aria-label="صفحه بندی">
                    <ul class="pagination justify-content-center my-4">
                        @for (int i = 1; i <= Model.PagingInfo.TotalPage; i++)
                        {
                            var link = $"/AllProducts{Model.PagingInfo.UrlParam}&page={i}";
                            <li class="page-item @(i == Model.PagingInfo.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@link">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <h4 class="m-auto alert text-center h3 alert-warning"> محصولی وجود ندارد </h4>
        }
    </form>



</div>